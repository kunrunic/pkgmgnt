pkg_release_root: ~/PKG/RELEASE
git:
  repo_root: null  # 입력하는 경우 create-pkg 시 해당 정보로 자동 설정됩니다.
  repo_url: "https://github.com/org/repo"
  keyword_prefix: "DEV-CODE:"
sources:
  - /path/to/source-A
  - /path/to/source-B
  
source:
  # 소스 스캔 제외 (glob 지원)
  exclude:
    - "**/build/**"
    - "**/*.tmp"
    - "**/bk"
    - "**/*.sc*"
    - "**/unit_test/**"
    - "Jamrules*"
    - "Jamfile*"
    - "**/Jamrules*"
    - "**/Jamfile*"

artifacts:
  root: ~/HOME
  targets: [bin, lib, data]
  # 배포/설치 영역 제외 (glob/패턴)
  exclude:
    - log                # 정확히 log 디렉터리
    - tmp/**             # tmp 이하 전체
    - "*.bak"            # 확장자 패턴
    - "**/*.tmp"         # 모든 하위에서 .tmp

watch:
  interval_sec: 60
  on_change: []   # 변경 발생 시 실행할 action 이름 리스트
  detect: true
  telegram:
    enabled: false
    bot_token: ""
    tls_verify: true      # 사내 SSL 프록시 사용 시 false 또는 ca_file 지정
    ca_file: null         # 사설 CA 번들 경로 (예: /etc/ssl/certs/company-ca.pem)
    subscribers_file: ~/pkgmgr/config/telegram-subscribers.yaml  # 승인된 수신자 별도 저장소
    admin_chat_ids: []    # /approve, /reject 권한자 chat id 목록
    chat_id: ""           # fallback only (read-only compatibility)
    chat_ids: []          # fallback only (read-only compatibility)
    message_prefix: "[pkgmgr]"
    notify_on: [fail, warn]
    dedup: true
    registration:
      enabled: true
      auto_reply: true
      notify_admin_on_start: true
    channels:
      detect:
        enabled: true
        message_file: null   # 지정 시 이 파일 본문을 detect 텔레그램 메시지로 그대로 전송
        max_chars: 3800      # 본문 길이 제한(초과분은 자동 생략)
        wrap_width: 72       # 텔레그램 가로폭에 맞춰 줄바꿈
        message_file_max_lines: 120  # detect 파일에서 보낼 최대 라인 수(summary/by_reason 위주)
      lifecycle:
        enabled: false
        events: [create_pkg, update_pkg, update_pkg_release, cancel_pkg_release, close_pkg, delete_pkg]
      git:
        enabled: false
        repo_root: null
        branches: []
      jenkins:
        enabled: false
        notify_on: [started, failed, success]
        notify_on_first_seen: false
        jobs:
          # - name: "aocs-build"
          #   url: "https://jenkins.example.com/job/aocs-build"
          #   user: "jenkins-user"
          #   api_token: "jenkins-api-token"
      file_watch:
        enabled: false
        max_chars: 3000
        files:
          # - /path/to/alert.txt
          # - path: /path/to/status.json
          #   encoding: utf-8

collectors:
  enabled: ["checksums"]

actions:
  # 각 액션은 하나 이상의 커맨드를 가질 수 있음.
  # 필드: cmd (필수, 보통 cwd 기준 경로), cwd(선택), env(선택; 이 커맨드에만 적용)
  export_cksum:
    - cmd: python export_cksum.py --pkg-dir /path/to/pkg --excel /path/to/template.xlsx
      cwd: /app/script             # 선택: 작업 디렉터리
      env: { APP_ENV: dev }        # 선택: 이 명령에만 적용할 환경변수
  export_world_dev:
    - cmd: python dev_world.py
      cwd: /app/script
  export_world_security:
    - cmd: python security_world.py
      cwd: /app/script
  noti_email:
    - cmd: sh noti_email.sh
      cwd: /app/script

auto_actions:
  create_pkg: []
  update_pkg: []
  update_pkg_release: []
  cancel_pkg_release: []
  delete_pkg: []
  close_pkg: []

detection:
  enabled: true
  system: null   # 장비/시스템 식별자(예: OCS2_DEV01)
  report_file: ~/pkgmgr/local/state/detect/detect-report.txt  # detect 결과 저장(내용 변경 시 자동 백업)
  ignore: []
  fail_on: [TRACKED_CHANGED_NOT_IN_PKG, UNTRACKED_NOT_IN_PKG, AMBIGUOUS_PKG]
  warn_on: [CHANGED_NOT_UPDATED, DELETED_NOT_UPDATED]
